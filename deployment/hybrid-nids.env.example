# Copy this file to deployment/hybrid-nids.env and edit values for Ubuntu.

# Network interface connected to SPAN/mirror port.
NIDS_INTERFACE=eth1

# Network range to protect.
HOME_NET=192.168.10.0/24

# Project directory on Ubuntu.
HYBRID_NIDS_HOME=/opt/hybrid-nids

# PCAP capture settings.
PCAP_DIR=/opt/hybrid-nids/pcap_traffic
PCAP_PREFIX=traffic
PCAP_ROTATE_SECONDS=300
PCAP_MAX_FILE_MB=512
PCAP_RETENTION_HOURS=6
PCAP_MAX_TOTAL_GB=20
PCAP_MIN_FREE_PERCENT=15
PCAP_TMP_MAX_MINUTES=10

# JSONL/log retention.
LOG_DIR=/opt/hybrid-nids/logs
JSONL_MAX_MB=512
JSONL_KEEP_LINES=200000

# ---------------------------------------------------------------------------
# XAC THUC ELASTICSEARCH / KIBANA  (BAO MAT TANG GIAM SAT)
# ---------------------------------------------------------------------------
# Stack ELK da BAT xpack.security. Dat mat khau MANH truoc khi chay (>= 12 ky tu).
# TUYET DOI khong commit file hybrid-nids.env that len git.
#   ELASTIC_PASSWORD          : mat khau tai khoan sieu quyen 'elastic'.
#   KIBANA_SYSTEM_PASSWORD    : mat khau tai khoan he thong 'kibana_system'
#                               (khoi tao 1 lan bang:
#                                bin/elasticsearch-reset-password -u kibana_system).
ELASTIC_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
KIBANA_SYSTEM_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Ket noi Elasticsearch (Logstash + detector dung chung tai khoan nay).
# ES_USER/ES_PASSWORD phai khop ELASTIC_PASSWORD o tren.
ES_URL=http://127.0.0.1:9200
ES_USER=elastic
ES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Chi so Elasticsearch can don dep dinh ky (retention).
ES_INDEX_PATTERNS=hybrid-nids-fused-alerts-* hybrid-nids-ai-* hybrid-nids-ai-alerts-* hybrid-nids-suricata-*
# Index Kibana/web panel dung de thong ke tong quan. Phai khop index pattern tren Kibana.
ES_INDEX_PATTERN=hybrid-nids-fused-alerts-*
# Mui gio cho cac the Hom nay/7 ngay/30 ngay tren web panel.
REPORT_TIME_ZONE=+07:00

# AI detector settings.
# Security: chi load model trong thu muc models/ va kiem SHA-256 neu metadata co hash.
NIDS_ALLOW_UNTRUSTED_MODEL_PATH=0
NIDS_MODEL_PATH=/opt/hybrid-nids/models/nids_rf_pipeline.pkl
NIDS_METADATA_PATH=/opt/hybrid-nids/models/metadata.json
NIDS_SCHEMA_PATH=/opt/hybrid-nids/models/feature_schema_model.json
# PCAP direct inference is an integration path. Official thesis metrics use
# CSV flow records that match the 41-feature schema above.
NIDS_TARGET_PCAP=/opt/hybrid-nids/pcap_traffic/traffic_latest.pcap
NIDS_OUTPUT_LOG=/opt/hybrid-nids/logs/ai_alerts.jsonl
NIDS_BATCH_SIZE=4096
NIDS_SLEEP_SECONDS=2

# Hybrid alert fusion settings.
SURICATA_EVE_LOG=/var/log/suricata/eve.json
HYBRID_AI_ALERT_LOG=/opt/hybrid-nids/logs/ai_alerts.jsonl
HYBRID_FUSED_ALERT_LOG=/opt/hybrid-nids/logs/hybrid_alerts.jsonl
HYBRID_FUSION_WINDOW_SECONDS=300


# ---------------------------------------------------------------------------
# WEB CONTROL PANEL AUTHENTICATION
# ---------------------------------------------------------------------------
# Bat dang nhap web panel. Dat mat khau manh trong file .env that, khong commit.
PANEL_USER=admin
PANEL_PASS=REPLACE_WITH_STRONG_PANEL_PASSWORD
PANEL_HOST=0.0.0.0
PANEL_PORT=8080
KIBANA_URL=http://192.168.199.146:5601

# Optional demo-only extra users. De trong neu khong dung.
PANEL_PASS_CUONG=
PANEL_PASS_LAM=
PANEL_PASS_HUY=

# Optional alert channels. Keep these secrets out of git.
# ALERT_CHANNELS_ENABLED=0 means NIDS starts without external notification spam.
# Set ALERT_CHANNELS_ENABLED=1 only in real operation or controlled demo.
ALERT_CHANNELS_ENABLED=0
ALERT_COOLDOWN_SECONDS=60
ALERT_MIN_AI_SCORE=0.90
ALERT_SEND_AI_ONLY=0
ALERT_SEND_SURICATA_ONLY=1
DISCORD_NIDS_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
