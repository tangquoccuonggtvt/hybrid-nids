[Unit]
Description=Hybrid-NIDS Suricata and AI alert fusion
After=network-online.target hybrid-nids-ai-detector.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hybrid-nids
EnvironmentFile=/opt/hybrid-nids/deployment/hybrid-nids.env
ExecStart=/usr/bin/bash /opt/hybrid-nids/scripts/run_hybrid_fusion_loop.sh /opt/hybrid-nids/deployment/hybrid-nids.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
