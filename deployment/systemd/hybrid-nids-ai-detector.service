[Unit]
Description=Hybrid-NIDS Random Forest AI detector
After=network-online.target hybrid-nids-capture.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hybrid-nids
EnvironmentFile=/opt/hybrid-nids/deployment/hybrid-nids.env
ExecStart=/usr/bin/bash /opt/hybrid-nids/scripts/run_ai_detector_loop.sh /opt/hybrid-nids/deployment/hybrid-nids.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
